# Copia este archivo como .env (o define estas variables en el entorno / en el panel del hosting)
# Nunca subas el archivo .env real con credenciales reales al repositorio.

# Base de datos
DB_URL=jdbc:mysql://localhost:3306/edificio_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USUARIO=root
DB_CLAVE=

# SMTP para la recuperacion de clave (por ejemplo Gmail con contrasena de aplicacion)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=no-responder@edificio-app.local
